# ---------------------------------------------------------------------------
# Commodity Price Ingestion Pipeline — environment template
#
# This file is COMMITTED and contains no real secrets. It documents every
# variable the stack expects.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is gitignored. Never commit it.
# ---------------------------------------------------------------------------

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# Read by the postgres image's entrypoint on FIRST boot to create the cluster.
# Changing these later has no effect on an existing volume — you must
# `docker compose down -v` to re-bootstrap. See README.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=replace_me_with_a_local_password
POSTGRES_DB=commodities

# Host-side port. Change this if something already owns 5432 on your machine
# (a native Postgres install is the usual culprit). The container always
# listens on 5432 internally regardless of this value.
POSTGRES_HOST_PORT=5432

# ─── Application database connection ───────────────────────────────────────
# Used by Python code running on the HOST (your terminal, pytest, local runs).
# Note the host is `localhost` — it crosses the published port mapping.
# Code running INSIDE a container on pipeline-net would use `postgres` instead.
# The `+psycopg` suffix tells SQLAlchemy to use the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://pipeline:replace_me_with_a_local_password@localhost:5432/commodities

# ─── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me_with_a_local_password
GRAFANA_HOST_PORT=3000

# ─── Placeholders for later sprints ────────────────────────────────────────
# Declared now so the contract is visible, wired up when we get there.

# The Chaos Switch. When true, the pipeline randomly injects schema
# mismatches, nulls, or network timeouts to exercise our alerting path.
SIMULATE_FAILURE=False
FAILURE_PROBABILITY=0.3

# Market data source.
COMMODITY_API_KEY=

# Discord incoming webhook for critical alerts.
DISCORD_WEBHOOK_URL=
